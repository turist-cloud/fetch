{
  "name": "@turist/fetch",
  "version": "7.2.0",
  "description": "Opinionated `fetch` optimized for use inside microservices",
  "license": "MIT",
  "repository": "turist-cloud/fetch",
  "files": [
    "dist/"
  ],
  "main": "dist/index.js",
  "scripts": {
    "prettier": "find . -path './**/*.ts' -not -path '*/node_modules/*'  -not -path '*/dist/*' -exec sh -c 'for n; do tsfmt -r \"$n\" || exit 1; done' sh {} +",
    "git-pre-commit": "find . -path './**/*.ts' -not -path '*/node_modules/*' -not -path '*/dist/*' -exec sh -c 'for n; do tsfmt --verify \"$n\" || exit 1; done' sh {} +",
    "test": "jest --coverage",
    "build": "rm -rf ./dist && ncc build src/index.ts -m -s -o dist",
    "prepublish": "npm run build",
    "prepare": "husky"
  },
  "peerDependencies": {
    "node-fetch": "2"
  },
  "devDependencies": {
    "@types/debug": "4.1.12",
    "@types/jest": "29.5.14",
    "husky": "9.1.7",
    "@vercel/ncc": "0.38.3",
    "agentkeepalive": "4.5.0",
    "async-retry-ng": "2.0.1",
    "debug": "4.4.0",
    "jest": "29.7.0",
    "lint-staged": "15.2.11",
    "lru-cache": "11.0.2",
    "node-fetch": "2.7.0",
    "raw-body": "2.5.2",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2",
    "typescript-formatter": "7.2.2"
  },
  "dependencies": {
    "@types/node-fetch": "2"
  },
  "overrides": {
    "js-yaml": "^4.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "testEnvironment": "node"
  }
}
